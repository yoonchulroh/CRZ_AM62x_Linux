[Unit]
Description=AER module 3: 0.975 s frames every 0.48 s
Documentation=file:/usr/local/share/aer/README.md
PartOf=aer.target

[Service]
ExecStart=/usr/local/bin/aer-framer
DynamicUser=yes
RuntimeDirectory=aer/framer
RuntimeDirectoryMode=0755
Restart=always
RestartSec=2

[Install]
WantedBy=aer.target
