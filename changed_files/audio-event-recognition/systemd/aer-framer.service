[Unit]
Description=Audio event recognition: framing (0.975 s frames, 0.48 s hop)
PartOf=aer.target
# keep retrying (e.g. display waiting for the compositor)
StartLimitIntervalSec=0
After=aer-preprocess.service

[Service]
Type=simple
User=mango
Group=mango
RuntimeDirectory=audio-event
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
ExecStart=/opt/audio-event/bin/aer-framer -c /opt/audio-event/config.ini
Restart=always
RestartSec=2

[Install]
WantedBy=aer.target
