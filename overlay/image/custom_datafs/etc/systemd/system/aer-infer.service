[Unit]
Description=AER module 4: YAMNet inference (TensorFlow Lite)
Documentation=file:/usr/local/share/aer/README.md
PartOf=aer.target

[Service]
ExecStart=/usr/local/bin/aer-infer
DynamicUser=yes
RuntimeDirectory=aer/infer
RuntimeDirectoryMode=0755
Restart=always
RestartSec=2

[Install]
WantedBy=aer.target
