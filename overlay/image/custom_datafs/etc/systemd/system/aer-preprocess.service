[Unit]
Description=AER module 2: mono, 16 kHz, float32 conversion
Documentation=file:/usr/local/share/aer/README.md
PartOf=aer.target

[Service]
ExecStart=/usr/local/bin/aer-preprocess
DynamicUser=yes
RuntimeDirectory=aer/preprocess
RuntimeDirectoryMode=0755
Nice=-5
Restart=always
RestartSec=2

[Install]
WantedBy=aer.target
