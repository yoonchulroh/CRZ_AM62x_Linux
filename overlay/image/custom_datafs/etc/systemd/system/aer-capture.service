[Unit]
Description=AER module 1: microphone capture (ALSA)
Documentation=file:/usr/local/share/aer/README.md
PartOf=aer.target
After=sound.target

[Service]
ExecStart=/usr/local/bin/aer-capture
DynamicUser=yes
RuntimeDirectory=aer/capture
RuntimeDirectoryMode=0755
SupplementaryGroups=audio
Nice=-10
Restart=always
RestartSec=2

[Install]
WantedBy=aer.target
