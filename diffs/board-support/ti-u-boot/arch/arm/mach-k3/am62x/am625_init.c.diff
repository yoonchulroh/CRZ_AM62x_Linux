--- a/board-support/ti-u-boot/arch/arm/mach-k3/am62x/am625_init.c
+++ b/board-support/ti-u-boot/arch/arm/mach-k3/am62x/am625_init.c
@@ -317,7 +317,13 @@
 			return MMCSD_MODE_FS;
 		return MMCSD_MODE_EMMCBOOT;
 	case BOOT_DEVICE_MMC:
-		if (bootmode_cfg & MAIN_DEVSTAT_PRIMARY_MMC_FS_RAW_MASK)
+		/*
+		 * Falcon mode builds the R5 SPL without raw MMC support and
+		 * loads tifalcon.bin/fitImage from the rootfs; in raw mode the
+		 * kernel load would fail with -ENOSYS instead of trying the FS.
+		 */
+		if ((bootmode_cfg & MAIN_DEVSTAT_PRIMARY_MMC_FS_RAW_MASK) &&
+		    IS_ENABLED(CONFIG_SPL_SYS_MMCSD_RAW_MODE))
 			return MMCSD_MODE_RAW;
 	default:
 		return MMCSD_MODE_FS;
